# ─── Serveur ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origine(s) autorisée(s) pour le dashboard et le site (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:8765
# Adresse publique de l'espace client (liens envoyés par e-mail)
CLIENT_APP_URL=http://localhost:4000

# ─── Base de données ───────────────────────────────────────
# Local : sqlite (aucune installation). Production cPanel : mysql
DB_CLIENT=sqlite
DB_FILENAME=./data/siipaf.sqlite
# DB_CLIENT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=c2777901c_siipaf
# DB_PASSWORD=
# DB_NAME=c2777901c_siipaf

# ─── Sécurité ──────────────────────────────────────────────
# Chaîne aléatoire longue (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-moi
JWT_EXPIRES_IN=8h

# Compte super administrateur créé au premier « npm run setup »
ADMIN_EMAIL=admin@siipaf.com
ADMIN_PASSWORD=change-moi-aussi
ADMIN_NAME=Administrateur SIIPAF

# ─── Règles métier ─────────────────────────────────────────
# Durée par défaut d'une option (pré-réservation), surchargée par projet
OPTION_DAYS_DEFAULT=7

# ─── E-mails (SMTP LWS) ────────────────────────────────────
SMTP_HOST=mail.siipaf.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SIIPAF SA <info@siipaf.com>"
# Destinataire des notifications internes (nouveaux prospects, messages)
MAIL_NOTIFY=info@siipaf.com
