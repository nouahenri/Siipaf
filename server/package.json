{
  "name": "siipaf-server",
  "version": "0.1.0",
  "private": true,
  "description": "API SIIPAF — admin, plan de masse, prospects, rendez-vous",
  "main": "app.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "migrate": "knex migrate:latest",
