{
  "expo": {
    "name": "SIIPAF",
    "slug": "siipaf",
    "owner": "nouahenris-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "siipaf",
    "userInterfaceStyle": "automatic",
    "description": "SIIPAF SA, promoteur et aménageur immobilier agréé MCLU : programmes, lotissements, conseillère Sita et espace client.",
    "ios": {
      "bundleIdentifier": "com.siipaf.com",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "SIIPAF utilise l’appareil photo pour joindre une photo à une demande de service après-vente.",
        "NSPhotoLibraryUsageDescription": "SIIPAF accède à vos photos pour les joindre à une demande de service après-vente ou à la déclaration d’un paiement (capture du reçu).",
        "NSFaceIDUsageDescription": "SIIPAF utilise Face ID pour protéger l’accès à votre espace client.",
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.siipaf.com",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "SIIPAF",
      "themeColor": "#E30613"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/site/logo-emblem.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/images/site/logo-emblem.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-asset",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SIIPAF utilise Face ID pour protéger l’accès à votre espace client."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E30613",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SIIPAF accède à vos photos pour les joindre à une demande de service après-vente.",
          "cameraPermission": "SIIPAF utilise l’appareil photo pour joindre une photo à une demande de service après-vente.",
          "microphonePermission": "SIIPAF utilise le micro pour que vous puissiez poser vos questions à voix haute à Sita, la conseillère virtuelle."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "./plugins/withReleaseSigning",
      "./plugins/withBuildArchs",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SIIPAF utilise le micro pour que vous puissiez poser vos questions à voix haute à Sita, la conseillère virtuelle.",
          "speechRecognitionPermission": "SIIPAF transcrit vos questions à voix haute pour les envoyer à Sita, la conseillère virtuelle.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://client.siipaf.com",
      "siteUrl": "https://siipaf.com",
      "erpUrl": "https://erp.siipaf.com",
      "eas": {
        "projectId": "3aef2b3e-a579-49aa-92f0-644daa535ee6"
      },
      "appStoreUrl": "",
      "playStoreUrl": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
